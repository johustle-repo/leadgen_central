APP_NAME="LeadGen Central"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://leadgen.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=leadgen_central
DB_USERNAME=leadgen_central
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360

FILESYSTEM_DISK=local
LEADGEN_CSV_MAX_KILOBYTES=5120

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@leadgen.example.com
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://leadgen.example.com/integrations/gmail/callback

DUSCAFF_BROCHURE_PATH=/var/www/leadgen-central/shared/DUSCAFF-Scaffolding-Products-brochure-2026.pdf
DUSCAFF_BROCHURE_NAME="DUSCAFF Scaffolding Products brochure 2026.pdf"

VITE_APP_NAME="${APP_NAME}"
